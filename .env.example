```env
# app
NODE_ENV=development
APP_PORT=3000
APP_BASE_URL=http://localhost:3000

# api server
API_PORT=4000
API_BASE_URL=http://localhost:4000

# cors
CORS_ALLOWED_ORIGINS=http://localhost:3000

# db (local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taplive_dev
DB_USER=postgres
DB_PASSWORD=password
DATABASE_URL=postgresql://user:password@localhost:5432/taplive_dev

# auth
JWT_SECRET=dev_jwt_secret
JWT_EXPIRES_IN=7d

# optional encryption
ENCRYPTION_KEY=dev_encryption_key

# rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# maps / location (placeholder)
MAP_PROVIDER=google
MAP_API_KEY=your_key_here

# geo / ip check (optional)
GEO_IP_PROVIDER=placeholder
GEO_IP_API_KEY=your_key_here

# uploads
UPLOAD_MAX_SIZE_MB=50
UPLOAD_ALLOWED_TYPES=video/mp4,image/jpeg,image/png

# logs
LOG_LEVEL=debug

# feature toggles
ENABLE_LIVE_SESSION=true
ENABLE_REPLAY=false
```


